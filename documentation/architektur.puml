@startuml
title RoboSim: vom Browser-Klick zum gezeichneten Zustand
left to right direction

skinparam backgroundColor #F7F9FC
skinparam shadowing false
skinparam roundcorner 18
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 15
skinparam ArrowColor #64748B
skinparam ArrowThickness 1.5
skinparam componentStyle rectangle
skinparam rectangle {
  BorderColor #CBD5E1
  FontColor #172033
}

actor "Nutzer:in" as user
cloud "GitHub Pages\nstatische Dateien" as pages #F1F5F9

rectangle "Browser" {
  component "Oberfläche\nHTML · CSS · JavaScript" as ui #EAF1FF
  component "Pyodide · WASM\nbrowser_api.py\nSimulationService · Regler · Modell" as python #F1EAFE
  component "SVG\nKurs · Roboter · Spur" as svg #E8F7F1

  ui --> python : Eingabe und\nSimulationsschritt
  python --> ui : Zustand als JSON
  ui --> svg : Zeichnen
}

user --> ui : Tastatur · Regler
pages --> ui : Website
pages --> python : Python-Module

note bottom of python
  Der Simulationskern läuft im Browser.
  Kein Python-Webserver nötig.
end note
@enduml
