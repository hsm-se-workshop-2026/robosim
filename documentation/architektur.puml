@startuml
left to right direction
skinparam componentStyle rectangle

actor "Nutzer" as user
component "Weboberfläche\nweb_demo.py" as web
component "Tastaturadapter" as keyboard
component "Simulationsservice" as simulation
component "Rundkursregler" as controller
component "Robotermodell" as robot
component "Rundkurs" as track
component "NiceGUI-Anzeige" as view

user --> web : bedient
web --> keyboard : Tasteneingabe
web --> simulation : Start, Schritt,\nReglerauswahl
keyboard --> simulation : Radgeschwindigkeiten\nüber SimulationInputPort
simulation --> controller : fragt Radgeschwindigkeiten\nüber ControllerPort ab
controller --> track : nächster Punkt\nund Zielpunkt
simulation --> robot : bewegt Roboter
simulation --> view : neuer Zustand\nüber RobotViewPort
view --> track : Kurs und Abstand
view --> web : Darstellung
@enduml
